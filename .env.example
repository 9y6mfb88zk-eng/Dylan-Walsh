# ---- Required
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys. Powers conversation, briefing and the idea engine.

# ---- Voice (recommended). With neither key JARVIS uses the browser's built-in voices.
ELEVENLABS_API_KEY=           # elevenlabs.io → Profile → API key. Neural British butler voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George" (warm British male). Swap for any voice ID you prefer.
OPENAI_API_KEY=               # platform.openai.com → API keys. Whisper transcription (needed for voice on iPhone) + backup TTS.
# TTS_PROVIDER=elevenlabs     # elevenlabs | openai | browser  (auto-picks ElevenLabs, then OpenAI)
# OPENAI_TTS_VOICE=fable      # British-sounding OpenAI voice

# ---- Security (set this before exposing JARVIS to the internet)
JARVIS_PASSCODE=

# ---- Optional
# PORT=3000
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_TZ=Europe/Nicosia
# DEFAULT_LAT=34.9786
# DEFAULT_LON=33.7253
# DEFAULT_PLACE=Dhekelia, Cyprus
# BRIEFING_TIME=07:30          # daily push briefing, local time
# IDEAS_EVERY_MINUTES=30
# IDEAS_ENABLED=true
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=/VAPID_PRIVATE_KEY=   # auto-generated and stored in data/ if unset; run `npm run vapid` to pin them
# JARVIS_DATA_DIR=./data
