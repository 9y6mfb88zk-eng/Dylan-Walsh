# JARVIS backend configuration. Copy to .env for local use; on Render these go in the Environment tab.
# Never commit real values.

# ---- Required
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys. Conversation, tools, research, briefing, ideas.
JARVIS_SETUP_TOKEN=           # any long random string; you type it once to claim your JARVIS (Render generates one)
JARVIS_ENCRYPTION_KEY=        # 32 random bytes, base64 (Render generates one). Encrypts bank/calendar tokens. Don't change once set.
PUBLIC_URL=                   # https address of this server, e.g. https://jarvis-abcd.onrender.com (Render sets RENDER_EXTERNAL_URL automatically)

# ---- Voice
ELEVENLABS_API_KEY=           # elevenlabs.io → Profile → API Keys. Natural British butler voice (recommended).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George" (British male). Any ElevenLabs voice ID works.
OPENAI_API_KEY=               # platform.openai.com. REQUIRED for voice input in the Windows app and on iPhone (Whisper), backup voice, semantic memory.

# ---- Monzo (read-only)
MONZO_CLIENT_ID=              # developers.monzo.com → New OAuth Client → Confidential = yes
MONZO_CLIENT_SECRET=          # redirect URL to register: <PUBLIC_URL>/oauth/monzo/callback

# ---- Google Calendar (optional)
GOOGLE_CLIENT_ID=             # console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_SECRET=         # redirect URI to register: <PUBLIC_URL>/oauth/google/callback ; enable "Google Calendar API"

# ---- Optional
# NODE_ENV=production
# PORT=3000
# JARVIS_DATA_DIR=./data
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_TZ=Europe/London
# DEFAULT_LAT=51.5072
# DEFAULT_LON=-0.1276
# DEFAULT_PLACE=London, UK
# BRIEFING_TIME=07:30
# IDEAS_ENABLED=true
# JARVIS_WEB_SEARCH=true
# JARVIS_DEMO_FINANCE=false   # development only: clearly labelled TEST DATA bank account
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=   # auto-generated if unset; `npm run vapid` to pin them
# VAPID_SUBJECT=mailto:you@example.com
