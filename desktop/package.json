{
  "name": "jarvis-desktop",
  "productName": "JARVIS",
  "version": "6.7.0",
  "description": "JARVIS for Windows: runs your whole JARVIS on this laptop — local Hey JARVIS wake word, private server, tray app.",
  "author": "JARVIS",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "sync-shared": "node scripts/sync-shared.js",
    "dist": "npm run sync-shared && node scripts/prepare-server.js && electron-builder --win --x64 --publish never",
    "prepare-server": "node scripts/prepare-server.js",
    "dist:linux-dir": "npm run sync-shared && node scripts/prepare-server.js && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "onnxruntime-web": "1.20.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "node_modules/onnxruntime-web/dist/ort.wasm.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/package.json",
      "node_modules/ws/**/*",
      "models/*.onnx"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "JARVIS-Setup-6.7.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "bundle/server-app",
        "to": "server-app"
      },
      {
        "from": "bundle/node",
        "to": "node"
      },
      {
        "from": "bundle/asr",
        "to": "models/asr"
      },
      {
        "from": "models/kws",
        "to": "models/kws"
      }
    ]
  }
}
