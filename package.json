{
  "name": "jarvis",
  "version": "3.0.0",
  "private": true,
  "description": "JARVIS \u2014 personal AI operating system: cloud backend, iPhone PWA and Windows app with a local Hey JARVIS wake word.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node test/ui-check.js",
    "test:desktop": "cd desktop && npm test",
    "test:electron": "cd desktop && xvfb-run -a node test/electron-e2e.js",
    "desktop": "cd desktop && npm start",
    "vapid": "node scripts/vapid.js",
    "icons": "node scripts/icons.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
